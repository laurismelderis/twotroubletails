# Final public domain, without a trailing slash. Leave unset for local development.
SITE_URL=
# Set to true only on the production deployment after the domain is configured.
SITE_INDEXABLE=false
# Optional hosted payment URLs. Until configured, CTAs link to the existing
# MailerLite services page, where the original checkout and delivery still run.
LECTURE_CHECKOUT_URL=
CONSULTATION_CHECKOUT_URL=
